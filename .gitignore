# --- generated outputs: runs, checkpoints, evaluations, dashboard uploads
outputs/
*.h5
*.pth
*.pt
*.ckpt
*.zip
*.npy
*.npz

# Keras checkpoints are generated under outputs/; the three legacy models are tracked on purpose
*.keras
!models/legacy/*.keras
!models/unet/*/model.keras

# --- logs & OS cruft
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
