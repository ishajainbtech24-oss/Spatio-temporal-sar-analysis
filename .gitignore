# --- Python / tooling
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# --- environments & secrets
.venv/
venv/
env/
.env
*.env.local

# --- data (download separately, see docs/DATASET.md)
data/*
