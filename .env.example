# Copy to .env (git-ignored) or export these in your shell. All are optional.
# Folder that contains data/flood_events/HandLabeled (overrides data.root in configs/*.yaml)
SAR_DATA_ROOT=data/raw/sen1floods11/v1.1
# Where runs, evaluations and dashboard results are written
SAR_OUTPUT_DIR=outputs
# Trained run the dashboard should use (default: newest run under outputs/runs/)
SAR_FLOOD_RUN_DIR=outputs/runs/unet_sen1floods11
# Flask session key for flash messages; set a long random value if the dashboard is shared
SECRET_KEY=change-me
# Upload size limit for the dashboard (MB)
MAX_UPLOAD_MB=25
# Set to 0 to disable the legacy classifier (saves ~1 s and memory on first request)
SAR_FLOOD_LEGACY=1
